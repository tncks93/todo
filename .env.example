# Copy this file to .env.local and fill in real values. Never commit .env.local.

# MongoDB Atlas connection string (see README for setup)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?appName=<app>"

# GitHub OAuth App credentials — create one at https://github.com/settings/developers
# Authorization callback URL must be exactly: <APP_URL>/auth/github/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Base URL this app is served from (used to build the OAuth callback URL).
# Required in production (the app refuses to start OAuth without it, rather
# than trust a client-controlled Host header).
APP_URL=http://localhost:3000
